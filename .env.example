# Local Lakehouse — example environment (copy to .env and fill in generated values)
#   cp .env.example .env
# Generate secrets with: openssl rand -hex 32
# Never commit .env or real secrets — only .env.example is tracked.

# --- S3 (RustFS) ---
# Access key for RustFS S3 API (any placeholder OK for local dev).
RUSTFS_ACCESS_KEY=rustfsadmin
# Generate: openssl rand -hex 32
RUSTFS_SECRET_KEY=CHANGE_ME__openssl_rand_hex_32

# --- Polaris (Iceberg REST catalog) ---
# Bootstrap credentials for the initial root principal in canonical
# REALM,clientId,clientSecret triple form (e.g. POLARIS,root,<secret>).
# Field 1 is the realm (must match POLARIS_REALM), field 2 is the client id
# (`root` for bootstrap), field 3 is the 64-hex secret from
# `openssl rand -hex 32`. Legacy colon-pair clientId:clientSecret is still
# accepted by scripts/bootstrap-polaris.sh but is deprecated — use the triple.
# Generate secret field with: openssl rand -hex 32
POLARIS_BOOTSTRAP_CREDENTIALS=POLARIS,root,CHANGE_ME_SECRET
# Root secret backing Polaris in-memory auth (also used to derive test tokens).
# Generate: openssl rand -hex 32
POLARIS_ROOT_SECRET=CHANGE_ME__openssl_rand_hex_32
# OAuth2 client credential used by Trino/dbt (client_id:client_secret).
# After bootstrap this is normally quickstart_user:<secret>; keep placeholder until setup runs.
POLARIS_CREDENTIAL=quickstart_user:CHANGE_ME__openssl_rand_hex_32

# --- Full profile only (Trino/Superset/Airflow) ---
# Superset web secret key. Generate: openssl rand -hex 32
SUPERSET_SECRET_KEY=CHANGE_ME__openssl_rand_hex_32
# Airflow Fernet key (must be a valid Fernet key; generate via python -c
# "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
AIRFLOW_FERNET_KEY=CHANGE_ME__fernet_generate_key
# Password for the Airflow Postgres metastore user. Generate: openssl rand -hex 32
AIRFLOW_METASTORE_PASSWORD=CHANGE_ME__openssl_rand_hex_32

# --- Endpoints (do not change unless you remap ports) ---
# In-container S3 endpoint (service DNS; path-style access enabled).
S3_ENDPOINT_INTERNAL=http://rustfs:9000
# Host S3 endpoint (published port for DuckDB/host tooling).
S3_ENDPOINT_EXTERNAL=http://localhost:9000
